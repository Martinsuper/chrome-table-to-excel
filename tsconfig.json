{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./entrypoints/*"],
      "@components/*": ["./entrypoints/popup/components/*"],
      "@utils/*": ["./entrypoints/popup/utils/*"]
    },
    "types": ["chrome", "wxt/client"]
  },
  "include": [
    "entrypoints/**/*",
    "wxt.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
